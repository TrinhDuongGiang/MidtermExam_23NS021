<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Management System</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            color: #1f2937;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 50px auto;
        }

        .header {
            background: white;
            padding: 30px;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            margin-bottom: 25px;
        }

        .header h1 {
            margin: 0 0 8px;
            font-size: 30px;
        }

        .header p {
            margin: 0;
            color: #6b7280;
        }

        .form-card {
            background: white;
            padding: 25px;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            margin-bottom: 25px;
        }

        .form-card h2 {
            margin-top: 0;
        }

        form {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        input {
            flex: 1;
            min-width: 180px;
            padding: 12px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 14px;
        }

        input:focus {
            outline: none;
            border-color: #f5d1dd;
        }

        button {
            padding: 12px 22px;
            border: none;
            border-radius: 8px;
            background: #f5d1dd;
            color: #374151;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #edb8ca;
        }

        .table-card {
            background: white;
            padding: 25px;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            overflow-x: auto;
        }

        .table-card h2 {
            margin-top: 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th {
            background: #f5d1dd;
            color: #374151;
            padding: 14px;
            text-align: left;
            font-size: 14px;
        }

        td {
            padding: 14px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 14px;
        }

        tr:hover {
            background: #fdf5f7;
        }

        .price {
            font-weight: bold;
        }

        .vat {
            color: #059669;
            font-weight: bold;
        }

        footer {
            text-align: center;
            margin-top: 30px;
            padding: 20px;
            color: #6b7280;
            font-size: 14px;
        }
    </style>
</head>

<body>

<div class="container">

    <div class="header">
        <h1>Book Management System</h1>
        <p>Cloud-based book management with personalized VAT calculation</p>
    </div>

    <div class="form-card">
        <h2>Add New Book</h2>

        <form id="bookForm" action="/books" method="POST">

            <input
                type="text"
                id="productCode"
                name="productCode"
                placeholder="Product Code (e.g. 021001)"
                required
            >

            <input
                type="text"
                name="name"
                placeholder="Book Name"
                required
            >

            <input
                type="number"
                name="price"
                placeholder="Price"
                step="0.01"
                min="0"
                required
            >

            <button type="submit">
                Add Book
            </button>

        </form>
    </div>

    <div class="table-card">

        <h2>Book List</h2>

        <table>

            <thead>
                <tr>
                    <th>Product Code</th>
                    <th>Book Name</th>
                    <th>Original Price</th>
                    <th>VAT</th>
                    <th>Final Price</th>
                </tr>
            </thead>

            <tbody>

                {{#each books}}

                <tr>
                    <td>{{productCode}}</td>
                    <td>{{name}}</td>
                    <td>{{originalPrice}}</td>
                    <td class="vat">{{vatRate}}%</td>
                    <td class="price">{{finalPrice}}</td>
                </tr>

                {{/each}}

            </tbody>

        </table>

    </div>

    <footer>
        Trịnh Dương Giang | 23NS021 | VAT: 6%
    </footer>

</div>

<script>
    document.getElementById("bookForm").addEventListener("submit", function(event) {
        const productCode = document.getElementById("productCode").value.trim();

        if (!productCode.startsWith("021")) {
            event.preventDefault();

            alert(
                "Invalid product code!\n\n" +
                "Product code must start with 021."
            );
        }
    });
</script>

</body>
</html>
